<body
  style="
    background-image: url('<%= asset_path 'kuro_intro.jpg' %>');
    background-repeat: repeat;
    background-attachment: fixed;
    background-size: 150px 150px;
    font-family: 'Comic Sans MS', sans-serif;
    color: hotpink;
    text-align: center;
  "
>
  <h1
    style="
      font-size: 50px;
      text-shadow: 2px 2px lime;
      margin-bottom: 20px;
    "
  >
    KURO BLOG
  </h1>

  <p
    style="
      font-size: 24px;
      background: black;
      color: lime;
      padding: 15px;
      border: 4px dashed hotpink;
      display: inline-block;
      border-radius: 10px;
    "
  >
    <%= @title %>
  </p>

  <br /><br />

  <a
    href="<%= @link %>"
    style="
      display: inline-block;
      font-size: 20px;
      background: hotpink;
      color: black !important;
      text-decoration: none;
      border: 3px dashed cyan;
      padding: 10px 20px;
      border-radius: 8px;
      text-shadow: 1px 1px lime;
      box-shadow: 0 0 10px magenta;
      cursor: pointer;
    "
  >
    READ NOW!
  </a>

  <br /><br />

  <p style="font-size: 16px; color: yellow; text-shadow: 1px 1px hotpink;">
    You can NOT unsubscribe. Mwahahahaha.
  </p>
</body>
