<body
  style="
  background-image: url('<%= asset_path 'kuro_intro.jpg' %>');
  background-repeat: repeat;
  background-attachment: fixed;
  background-size: 150px 150px;
"
>
  <h1
    style="text-align:center; color: hotpink; font-size: 50px; text-shadow: 2px 2px lime;"
  >
    KURO BLOG
  </h1>

  <% if flash[:error] %>
    <div style="background: red; color: white; padding: 10px; text-align: center; max-width: 800px; margin: 10px auto; font-family: 'Comic Sans MS';">
      <%= flash[:error] %>
    </div>
  <% end %>

  <% if flash[:success] %>
    <div style="background: green; color: white; padding: 10px; text-align: center; max-width: 800px; margin: 10px auto; font-family: 'Comic Sans MS';">
      <%= flash[:success] %>
    </div>
  <% end %>

  <div style="text-align: center; margin: 20px;">
    <button
      id="add-post-btn"
      style="
        font-size: 20px;
        background: lime;
        color: black;
        border: 3px dashed hotpink;
        padding: 10px 20px;
        cursor: pointer;
        font-family: 'Comic Sans MS';
      "
    >
      + ADD POST
    </button>
  </div>

  <div
    id="add-post-form"
    style="
      display: none;
      background: rgba(0,0,0,0.95);
      border: 5px dashed lime;
      padding: 20px;
      max-width: 800px;
      margin: 20px auto;
      font-family: 'Comic Sans MS';
    "
  >
    <div id="password-gate">
      <h3 style="color: hotpink; text-align: center;">ENTER PASSWORD</h3>
      <div style="text-align: center;">
        <input
          type="password"
          id="password-input"
          placeholder="Password"
          style="padding: 10px; font-size: 16px; width: 200px;"
        />
        <button
          id="password-submit"
          style="
            padding: 10px 20px;
            font-size: 16px;
            background: hotpink;
            border: 2px solid cyan;
            cursor: pointer;
          "
        >
          ENTER
        </button>
      </div>
    </div>

    <div id="post-form-content" style="display: none;">
      <h3 style="color: lime; text-align: center;">NEW KURO POST</h3>
      <%= form_tag("/blog", method: :post, multipart: true, id: "new-post-form") do %>
        <input type="hidden" name="password" id="form-password" value="" />

        <div style="margin-bottom: 15px;">
          <label style="color: white; display: block; margin-bottom: 5px;">TITLE:</label>
          <input
            type="text"
            name="title"
            required
            style="width: 100%; padding: 10px; font-size: 16px; box-sizing: border-box;"
            placeholder="what did kuro do today?"
          />
        </div>

        <div style="margin-bottom: 15px;">
          <label style="color: white; display: block; margin-bottom: 5px;">IMAGE:</label>
          <input
            type="file"
            name="image"
            accept="image/*"
            style="color: white;"
          />
        </div>

        <div style="margin-bottom: 15px;">
          <label style="color: white; display: block; margin-bottom: 5px;">BODY (markdown supported):</label>
          <textarea
            name="body"
            required
            rows="6"
            style="width: 100%; padding: 10px; font-size: 16px; box-sizing: border-box;"
            placeholder="kuro did a big stretch today..."
          ></textarea>
        </div>

        <div style="text-align: center;">
          <button
            type="submit"
            style="
              font-size: 18px;
              background: lime;
              color: black;
              border: 3px dashed hotpink;
              padding: 10px 30px;
              cursor: pointer;
              font-family: 'Comic Sans MS';
            "
          >
            POST IT!
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    document.getElementById('add-post-btn').addEventListener('click', function() {
      const form = document.getElementById('add-post-form');
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('password-submit').addEventListener('click', function() {
      const password = document.getElementById('password-input').value;
      if (password === 'Kuro422') {
        document.getElementById('password-gate').style.display = 'none';
        document.getElementById('post-form-content').style.display = 'block';
        document.getElementById('form-password').value = password;
      } else {
        alert('Wrong password!');
      }
    });

    document.getElementById('password-input').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('password-submit').click();
      }
    });
  </script>

  <form
    method="get"
    action="/blog"
    style="
        background: black;
        padding: 15px;
        border: 4px dashed lime;
        max-width: 800px;
        margin: 20px auto;
        text-align: center;
        color: white;
        font-family: 'Comic Sans MS'
    "
  >
    <strong>FIND KURO POST BY DATE</strong><br /><br />

    <select name="year" id="filter-year">
      <option value="">Year</option>
      <% (2025..2026).each do |y| %>
        <option
          value="<%= y %>"
          <%= 'selected' if params[:year].present? && params[:year] == y.to_s %>
        >
          <%= y %>
        </option>
      <% end %>
    </select>

    <select name="month">
      <option value="">Month</option>
      <% (1..12).each do |m| %>
        <option
          value="<%= m %>"
          <%= 'selected' if params[:month].present? && params[:month] == m.to_s %>
        >
          <%= Date::MONTHNAMES[m] %>
        </option>
      <% end %>
    </select>

    <input
      type="number"
      name="day"
      min="1"
      max="31"
      value="<%= params[:day] %>"
      placeholder="DAY"
      style="width: 70px;"
    />

    <br /><br />

    <button
      id="filter-submit"
      style="
        font-size: 18px;
        background: hotpink;
        border: 3px dashed cyan;
        padding: 5px 15px;
        cursor: pointer;
      "
      <%= 'disabled' unless params[:year].present? %>
    >
      SEARCH
    </button>

    <script>
      const yearSelect = document.getElementById("filter-year");
      const submitBtn = document.getElementById("filter-submit");

      function updateButtonAndOutline() {
        const hasValue = !!yearSelect.value;
        submitBtn.disabled = !hasValue;
        yearSelect.style.outline = hasValue ? "none" : "2px solid red";
      }

      updateButtonAndOutline();

      yearSelect.addEventListener("change", updateButtonAndOutline);
    </script>

    &nbsp;&nbsp;

    <a
      href="/blog"
      style="
        font-size: 18px;
        background: gray;
        color: black;
        border: 3px dashed white;
        padding: 5px 15px;
        text-decoration: none;
    "
    >
      CLEAR
    </a>
  </form>
  <div style="text-align: center;">
    <a
      href="/"
      style="
      font-size: 30px; 
      color: lime; 
      background: black; 
      padding: 10px; 
      border: 4px dashed pink;
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
    "
    >
      ← BACK
    </a>
  </div>

  <% if @posts.empty? %>
    <div
      style="
                border: 5px dashed cyan;
                background: rgba(0,0,0,0.85);
                color: white;
                margin: 20px auto;
                padding: 15px;
                max-width: 800px;
                border-radius: 15px;
                font-family: 'Comic Sans MS'
                box-shadow: 0 0 20px magenta;
            "
    >
      <h2 style="color: lime;"><%= 'NOTHING FOUND' %></h2>
      <div><%= 'PROBABLY SLEPT AND PLAYED' %></div>
    </div>
  <% end %>

  <% @posts.each do |post| %>
    <div
      style="
          border: 5px dashed cyan;
          background: rgba(0,0,0,0.85);
          color: white;
          margin: 20px auto;
          padding: 15px;
          max-width: 800px;
          border-radius: 15px;
          font-family: 'Comic Sans MS';
          box-shadow: 0 0 20px magenta;
        "
    >
      <h2 style="color: lime;"><%= post[:title] %></h2>
      <p style="color: yellow; font-size: 16px;"><%= post[:date] %></p>
      <div>
        <%
          content =
            post[:content].gsub(/<img [^>]*src="([^"]+)"[^>]*>/) do
              img_url = $1
              "<button class=\"toggle-img\" data-src=\"#{img_url}\" style=\"display:block; margin:10px auto; padding:5px 10px; cursor:pointer;\">SHOW IMAGE</button>"
            end
        %>
        <%= content.html_safe %>
      </div>
      <div style="text-align: center; margin-top: 10px;">
        <%=
          link_to "COMMENTS (#{post[:comment_count]})",
                  blog_show_path(filename: post[:filename], page: @page),
                  style:
                    '
        display: inline-block;
        background: hotpink;
        color: black;
        padding: 8px 15px;
        border: 3px solid cyan;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        font-size: 16px;
        box-shadow: 0 0 10px magenta;
        cursor: pointer;
      '
        %>
      </div>
    </div>
  <% end %>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll(".toggle-img").forEach((button) => {
        button.addEventListener("click", () => {
          let img = button.nextElementSibling;

          if (!img || img.tagName !== "IMG") {
            img = document.createElement("img");
            img.src = button.dataset.src;
            img.style.maxWidth = "100%";
            img.style.height = "auto";
            img.style.display = "block";
            img.style.margin = "10px auto";

            button.insertAdjacentElement("afterend", img);
            button.textContent = "HIDE IMAGE";
            return;
          }

          if (img.style.display === "none") {
            img.style.display = "block";
            button.textContent = "HIDE IMAGE";
          } else {
            img.style.display = "none";
            button.textContent = "SHOW IMAGE";
          }
        });
      });
    });
  </script>

  <div style="text-align:center; margin-top: 20px;">
    <% if @page > 1 %>
      <%=
        link_to '⬅ Previous',
                blog_path(
                  year: params[:year],
                  month: params[:month],
                  day: params[:day],
                  page: @page - 1,
                ),
                style: 'margin-right:10px; font-size:20px; color: cyan;'
      %>
    <% end %>
    <% if @page < @total_pages %>
      <%=
        link_to 'Next ➡',
                blog_path(
                  year: params[:year],
                  month: params[:month],
                  day: params[:day],
                  page: @page + 1,
                ),
                style: 'margin-left:10px; font-size:20px; color: cyan;'
      %>
    <% end %>
  </div>

  <br /><br />

  <a
    href="/"
    style="
        font-size: 30px; 
        color: lime; 
        background: black; 
        padding: 10px; 
        border: 4px dashed pink;
        display: inline-block;
        margin-top: 20px;
        text-decoration: none;
    "
  >
    ← BACK
  </a>
</body>
