<body
  style="
  background-image: url('<%= asset_path 'kuro_intro.jpg' %>');
  background-repeat: repeat;
  background-attachment: fixed;
  background-size: 150px 150px;
  text-align: center;
  font-family: 'Comic Sans MS', cursive;
"
>
  <h1
    style="
      color: cyan; 
      background: magenta; 
      font-size: 60px; 
      padding: 20px; 
      border: 5px dotted lime;
      margin-bottom: 30px;
      transform: rotate(3deg);
    "
  >
    ME (I UPDATE!)
  </h1>

  <% @images.each do |img| %>
    <div
      style="
        display: inline-block; 
        margin: 10px; 
        padding: 5px; 
        border: 4px dashed hotpink; 
        background: lightblue;
        transform: rotate(<%= rand(-15..15) %>deg);
        text-align: center;
      "
    >
      <%= image_tag img, width: rand(150..400) %>
      <p
        style="
          color: black;
          font-size: 18px;
          font-weight: bold;
          margin: 5px 0 0 0;
        "
      >
        <%= @img_captions[img] %>
      </p>
    </div>
  <% end %>

  <br /><br />
  <a
    href="/"
    style="
      font-size: 30px; 
      color: magenta; 
      background: cyan; 
      padding: 10px; 
      border: 4px dotted yellow;
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
      transform: rotate(-2deg);
    "
  >
    ← BACK
  </a>
</body>
