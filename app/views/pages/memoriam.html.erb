<body
  style="
    background-image: url('<%= asset_path 'heaven.jpg' %>');
    background-repeat: repeat;
    background-attachment: fixed;
    background-size: 150px 150px;
    text-align: center;
    font-family: 'Comic Sans MS'
  "
>
  <h1
    style="
      color: gold; 
      background: gray; 
      font-size: 60px; 
      padding: 20px; 
      border: 5px gold;
      margin-bottom: 30px;
    "
  >
    IN LOVING MEMORY
  </h1>

  <% @pets.each do |img| %>
    <div
      style="
        display: inline-block; 
        margin: 10px; 
        padding: 5px; 
        border: 3px dotted orange; 
        background: gray;
      "
    >
      <%= image_tag img, width: 400 %>
      <p style="color: gold; font-size: 18px;">
        <%= @pet_captions[img] %>
      </p>
    </div>
  <% end %>

  <br /><br />
  <a
    href="/"
    style="
      font-size: 30px; 
      color: lime; 
      background: black; 
      padding: 10px; 
      border: 4px dashed pink;
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
      transform: rotate(-2deg);
    "
  >
    ← BACK
  </a>
</body>
