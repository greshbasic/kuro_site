<body
  style="
    background-image: url('<%= asset_path 'heaven.jpg' %>');
    background-repeat: repeat;
    background-attachment: fixed;
    background-size: 150px 150px;
    text-align: center;
    font-family: 'Comic Sans MS'
  "
>
  <h1
    style="
      color: gold; 
      background: gray; 
      font-size: 60px; 
      padding: 20px; 
      border: 5px gold;
      margin-bottom: 30px;
    "
  >
    IN LOVING MEMORY
  </h1>

  <div style="display: flex; flex-direction: column; align-items: center;">
    <% @pets.each do |img| %>
      <div
        style="
        display: inline-block;
        margin: 10px;
        padding: 5px;
        border: 3px dotted orange;
        background: gray;
        text-align: center;
      "
      >
        <%= image_tag img, width: 400 %>
        <p style="color: gold; font-size: 18px; margin: 6px 0 0;">
          <%= @pet_captions[img] %>
        </p>
      </div>
    <% end %>
  </div>

  <div
    style="
    max-width: 300px;
    margin: 40px auto;
    padding: 20px;
    background: #eee;
    border: 2px solid #ccc;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
  "
  >
    <p style="font-size:20px;"><%= Respect.instance.count %> RESPECTS</p>

    <%=
      button_to 'PAY ONE RESPECTS',
                respects_path,
                method: :post,
                style:
                  '
          background:black;
          color:hotpink;
          border:2px solid hotpink;
          padding:10px 20px;
          border-radius:10px;
          cursor:pointer;
        '
    %>
  </div>

  <br /><br />
  <a
    href="/"
    style="
      font-size: 30px; 
      color: lime; 
      background: black; 
      padding: 10px; 
      border: 4px dashed pink;
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
      transform: rotate(-2deg);
    "
  >
    ← BACK
  </a>
</body>
